# Copy into a private deployment environment; never commit real values.
# No provider credential belongs in the desktop app or the public browser.
GONGZUO_RELAY_PUBLIC_URL=
WORKBUDDY_CLIENT_ID=
WORKBUDDY_CLIENT_SECRET=
# A canonical base64 string encoding 32 random bytes. Keep it across restarts.
GONGZUO_RELAY_ENCRYPTION_KEY=
# Absolute file path in a private persistent directory, writable by this process.
GONGZUO_RELAY_DATA_FILE=
PORT=8787
# Default is loopback behind an HTTPS reverse proxy. Do not expose this HTTP port.
BIND_HOST=127.0.0.1
